{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseRing",
  "version": "1.2.0",
  "identifier": "com.cg1995.pulsering",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "PulseRing",
        "url": "index.html#settings",
        "width": 880,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "decorations": true,
        "resizable": true
      },
      {
        "label": "tooltip",
        "title": "PulseRing Tooltip",
        "url": "index.html#tooltip",
        "width": 296,
        "height": 216,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false
      },
      {
        "label": "floating",
        "title": "PulseRing Floating Bar",
        "url": "index.html#floating",
        "width": 360,
        "height": 52,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Quiet system status monitor with live status colors.",
    "longDescription": "A quiet Windows tray and macOS menu bar system status monitor."
  }
}
